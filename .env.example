# Sample mode reads data/sample-*.json and does not call StockItUp.
# Set to 0 (and provide the API credentials) for live stock.
USE_SAMPLE_DATA=1

# Password for the login page. Required in every mode.
DASHBOARD_PASSWORD=

# StockItUp HTTP Basic credentials. Server-side only. Never expose these
# to the browser and never commit real values.
GOGEMBER_STOCKITUP_CLIENT_ID=
GOGEMBER_STOCKITUP_CLIENT_SECRET=

# Optional. Defaults to 38 (Go Gember at Brandhouse).
GOGEMBER_STOCKITUP_SELLER_ID=38

# Private Vercel Blob store connected to this project.
# On Vercel this is set for you as BLOB_STORE_ID. Locally, create a
# read-write token in the Blob store and put it here.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Random string. Vercel Cron sends it as Authorization: Bearer <value>.
CRON_SECRET=
